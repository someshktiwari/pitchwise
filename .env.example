# Copy to .env and fill in. All three have free tiers.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: request tracing with Langfuse (DECISIONS.md D-013).
# Leave empty to turn tracing off. Keys from cloud.langfuse.com (free tier).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
